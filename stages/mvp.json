  "tutorial": [
    {
      "phase": 1,
      "title": "命令を出して、10秒動かす",
      "lines": [
        "右のパネルで班を選び、「経路」のまま地図をクリックすると、移動する点を足せます。",
        "下のスライダーを動かすと、10秒の間に味方がどこまで進むかを薄い印で確かめられます。",
        "決めたら「▶ 実行」。敵も味方も同時に10秒だけ動いて、また止まります。"
      ]
    },
    {
      "phase": 2,
      "title": "遮蔽は「正面」からしか守らない",
      "lines": [
        "石垣などの遮蔽は、遮蔽の正面から±60°の向きから撃たれたときだけ、被害を×0.2にします。",
        "班のまわりの輪は制圧値です。黄色=動揺、オレンジ=制圧(動けない)、赤=釘付け(ほとんど撃てない)。",
        "正面から撃ち合うだけでは、どちらも遮蔽に守られて決着がつきません。"
      ]
    },
    {
      "phase": 3,
      "title": "一方が抑えて、もう一方が回り込む",
      "lines": [
        "1つの班は「保持」で撃ち続けて、敵を抑え込みます(制圧値を上げて動けなくする)。",
        "もう1つの班は、敵から見えない道を通って横へ回ります。「射撃禁止」にすると、見つかるまで撃たずに隠れて動けます。",
        "敵の遮蔽の効かない横から撃てば、一気に倒せます。"
      ]
    },
    {
      "phase": 6,
      "title": "困ったら",
      "lines": [
        "「撃つ敵を指定」で、2つの班の火力を1つの敵に集中できます。",
        "勝敗がついたら「リプレイを見る」で、敵の動きも含めて見返せます。"
      ]
    }
  ],
