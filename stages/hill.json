  "tutorial": [
    {
      "phase": 1,
      "title": "迫撃砲は「展開」してから撃つ",
      "lines": [
        "迫撃砲班を選び、「迫撃砲の射撃」で着弾させたい場所をクリック。撃つには展開(4秒)が必要で、自動で「展開する」になります。",
        "発射から4秒で着弾します。内側の輪(8 m)で被害、外側の輪(15 m)で制圧。",
        "味方のだれかがその場所を見ていないと、遠くへずれて落ちます(点線の矢印)。"
      ]
    },
    {
      "phase": 2,
      "title": "観測してから当てる",
      "lines": [
        "射撃班を、敵の陣地が見える生け垣などへ進めましょう。着弾を味方が見ていれば、その付近への次の射撃は正確になります。",
        "敵が来そうな場所が分かっているなら「待機射撃」も便利です。地点を登録しておくと、味方が敵を見つけた瞬間に正確に撃ちます。"
      ]
    },
    {
      "phase": 4,
      "title": "煙も使える",
      "lines": [
        "射撃班の「発煙手榴弾」(2個)は、30 m 先まで投げて半径8 mの煙を立てます。煙は視線をさえぎるので、開けた場所を渡るときに。",
        "迫撃砲の「榴弾」ボタンを押すと発煙弾に切り替わります(2発まで)。"
      ]
    }
  ]
